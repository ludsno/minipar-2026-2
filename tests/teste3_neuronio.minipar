# ==============================================================================
# TESTE 3: Neuronio Artificial (Perceptron) com Classes e Objetos
# Um neuronio com uma entrada e um bias aprende a produzir a saida desejada (0)
# ajustando os pesos pela regra delta ate o erro ser zero.
# Enunciado: Programa de Teste 3 (traducao da classe Neuronio em Python).
#
# Execucao: 1 computador. Entrada: nenhuma.
# Saida esperada: o neuronio aprende na iteracao 51 ("Iteracoes totais: 51").
# ==============================================================================

# Neuronio: atributos com os valores iniciais do enunciado (peso 0.5, bias 1, taxa 0.01)
class Neuronio {
    var input_val = 1;
    var output_desejado = 0;
    var peso = 0.5;
    var bias = 1;
    var peso_bias = 0.5;
    var taxa_aprendizado = 0.01;
    var erro = 999;
    var iteracao = 0;

    # Funcao de ativacao degrau: 1 se a soma ponderada for positiva, senao 0
    func ativacao(soma) {
        if (soma > 0) {
            return 1;
        }
        return 0;
    }

    # Treina ate o erro ser zero: soma ponderada -> ativacao -> erro -> ajuste dos pesos
    func treinar() {
        print("==== Teste 3: neuronio simples com classes e objetos ====");
        print("Entrada:", this.input_val, "Saida desejada:", this.output_desejado);

        while (this.erro != 0) {
            this.iteracao = this.iteracao + 1;

            var soma = (this.input_val * this.peso) + (this.bias * this.peso_bias);
            var saida = this.ativacao(soma);
            this.erro = this.output_desejado - saida;

            print("Iteracao:", this.iteracao);
            print("Soma ponderada:", soma);
            print("Saida:", saida);
            print("Erro:", this.erro);
            print("Peso entrada:", this.peso);
            print("Peso bias:", this.peso_bias);

            # Regra delta: peso = peso + taxa * entrada * erro
            if (this.erro != 0) {
                this.peso = this.peso + ((this.taxa_aprendizado * this.input_val) * this.erro);
                this.peso_bias = this.peso_bias + ((this.taxa_aprendizado * this.bias) * this.erro);
            }
        }

        print("Neuronio aprendeu dinamicamente.");
        print("Iteracoes totais:", this.iteracao);
        print("Peso final:", this.peso);
        print("Peso bias final:", this.peso_bias);
        print("Valor desejado:", this.output_desejado);
    }
}

# Programa principal: instancia o objeto e chama o metodo de treino
seq {
    var neuronio = new Neuronio();
    neuronio.treinar();
}
