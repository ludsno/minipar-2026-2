# ==============================================================================
# TESTE ADICIONAL: Estruturas de Controle da Gramatica (BNF)
# Exercita for classico com continue, do-while com break e declaracao de funcao
# com input (a funcao ler_nome so demonstra a sintaxe; ela nao e chamada).
#
# Execucao: 1 computador. Entrada: nenhuma.
# Saida esperada: "Controle OK: 7 2" (soma 0+1+2+4 = 7; o do-while para em 2).
# ==============================================================================

func ler_nome() {
    var nome = input("Nome: ");
    return nome;
}

seq {
    var soma = 0;
    # for com continue: soma 0, 1, 2 e 4 (pula o 3)
    for (var i = 0; i < 5; i = i + 1) {
        if (i == 3) {
            continue;
        }
        soma = soma + i;
    }

    var tentativas = 0;
    # do-while com break: sai do laco quando tentativas chega a 2
    do {
        tentativas = tentativas + 1;
        if (tentativas == 2) {
            break;
        }
    } while (tentativas < 10);

    print("Controle OK:", soma, tentativas);
}
