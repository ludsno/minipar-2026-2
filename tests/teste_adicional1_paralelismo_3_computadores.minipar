# ==============================================================================
# TESTE ADICIONAL 1: Paralelismo com 3 "Computadores" trocando Mensagens
# Tres tarefas (quicksort, multiplicacao de matrizes e fatorial) enviam o resumo
# dos seus resultados ao computador 1 por canais de comunicacao (c_channel).
#
# Execucao: 1 computador (localhost), simulando 3 computadores: cada
#   "computador" e uma thread do bloco par, e eles so trocam dados por mensagens
#   nas portas 5301, 5302 e 5303. Para dividir uma tarefa entre computadores
#   reais, ver o fork @computador em tests/demo_varios_computadores.minipar.
# Entrada: nenhuma.
# Saida esperada: os 3 resultados recolhidos no computador 1.
# ==============================================================================

# Resumo do resultado de cada "computador"
func quicksort_resumo() {
    return "PC1 QuickSort: [33,12,98,5,61] -> [5,12,33,61,98]";
}

func matrizes_resumo() {
    return "PC2 Matrizes: [[1,2],[3,4]] x [[5,6],[7,8]] -> [[19,22],[43,50]]";
}

func fatorial_resumo() {
    var n = 5;
    var fat = 1;
    var i = 1;
    while (i <= n) {
        fat = fat * i;
        i = i + 1;
    }
    return "PC3 Fatorial: 5! = 120";
}

seq {
    print("==== Teste adicional 1: paralelismo real com 3 computadores ====");
    print("Menu do Computador 1");
    print("1 - Quick sort no Computador 1: 127.0.0.1:5301");
    print("2 - Multiplicacao de matrizes no Computador 2: 127.0.0.1:5302");
    print("3 - Fatorial no Computador 3: 127.0.0.1:5303");

    var canal_pc1 = c_channel("127.0.0.1", 5301);
    var canal_pc2 = c_channel("127.0.0.1", 5302);
    var canal_pc3 = c_channel("127.0.0.1", 5303);

    par {
        # Computador 1: recebe os 3 resultados (receive bloqueia ate a mensagem chegar)
        seq {
            var resultado1 = receive(canal_pc1);
            var resultado2 = receive(canal_pc2);
            var resultado3 = receive(canal_pc3);
            print("Resultados recolhidos no Computador 1:");
            print(resultado1);
            print(resultado2);
            print(resultado3);
        }
        # Computadores 1, 2 e 3: cada um envia o seu resultado pelo seu canal
        seq {
            send(canal_pc1, quicksort_resumo());
        }
        seq {
            send(canal_pc2, matrizes_resumo());
        }
        seq {
            send(canal_pc3, fatorial_resumo());
        }
    }
}
