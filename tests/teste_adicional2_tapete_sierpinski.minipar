# ==============================================================================
# TESTE ADICIONAL 2: Tapete de Sierpinski (recursao com matriz)
# Preenche uma matriz 9 x 9 com '#', removendo recursivamente o quadrado central
# de cada bloco 3 x 3 (fractal de Sierpinski).
#
# Execucao: 1 computador. Entrada: nenhuma.
# Saida esperada: 9 linhas do tapete, com os furos nas posicoes centrais.
# ==============================================================================

# Preenche o bloco (linha, coluna) de lado 'tamanho': divide em 3 x 3 sub-blocos
# e chama a si mesma para os 8 sub-blocos ao redor do centro (o centro fica vazio)
func preencher(tela, linha, coluna, tamanho) {
    if (tamanho == 1) {
        tela[linha][coluna] = "#";
        return tela;
    }

    var novo = tamanho / 3;
    var i = 0;
    while (i < 3) {
        var j = 0;
        while (j < 3) {
            if (!((i == 1) && (j == 1))) {
                tela = preencher(tela, linha + (i * novo), coluna + (j * novo), novo);
            }
            j = j + 1;
        }
        i = i + 1;
    }

    return tela;
}

seq {
    print("==== Teste adicional 2: tapete de Sierpinski ====");
    var tamanho = 9;
    var tela = matrix(tamanho, tamanho, " ");
    tela = preencher(tela, 0, 0, tamanho);

    var i = 0;
    while (i < tamanho) {
        print(tela[i]);
        i = i + 1;
    }
}
